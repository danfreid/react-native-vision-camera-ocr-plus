{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest",
        "prebuildCommand": "chmod +x scripts/fix-ios-modules.sh scripts/fix-ios-document-recognizer.sh && ./scripts/fix-ios-modules.sh && ./scripts/fix-ios-document-recognizer.sh"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
